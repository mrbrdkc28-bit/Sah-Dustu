# BU DOSYAYI "keystore.properties" OLARAK KOPYALA VE KENDİ BİLGİLERİNLE DOLDUR.
# ASLA GIT'E EKLEME! (.gitignore'da zaten var)
#
# Keystore oluşturmak için terminalde şunu çalıştır:
#   keytool -genkey -v -keystore sahdustu.jks -keyalg RSA -keysize 2048 -validity 10000 -alias sahdustu
#
# Oluşan sahdustu.jks dosyasını proje kök dizinine koy.
# UYARI: Bu dosyayı ve şifreni KAYBETME. Kaybedersen uygulamayı bir daha
# güncelleyemezsin (Play Store aynı imzayı ister).

storeFile=../sahdustu.jks
storePassword=BURAYA_KEYSTORE_SIFRESI
keyAlias=sahdustu
keyPassword=BURAYA_ANAHTAR_SIFRESI
